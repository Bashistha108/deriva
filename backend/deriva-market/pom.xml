<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.deriva</groupId>
        <artifactId>deriva-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>deriva-market</artifactId>
    <name>Deriva Market</name>

    <dependencies>
        <!-- Need domain and risk/options if BlackScholesModel is used (Wait, BlackScholesModel is in domain/options currently, which we haven't moved yet!) -->
        <dependency>
            <groupId>com.deriva</groupId>
            <artifactId>deriva-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.deriva</groupId>
            <artifactId>deriva-risk</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <!-- Persistence API for @Entity, @Table, @Id etc. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Spring Data JPA for Repositories -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Web or Messaging if WebSockets are used in Market Data Services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

    </dependencies>
</project>
