<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="1" author="deriva">
        <createTable tableName="positions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_pos_user" references="users(id)"/>
            </column>
            <column name="instrument_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_pos_inst" references="instruments(id)"/>
            </column>
            <column name="option_contract_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_pos_opt" references="option_contracts(id)"/>
            </column>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="average_entry_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="realized_pnl" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="opened_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE positions ADD CONSTRAINT chk_pos_target 
            CHECK ((instrument_id IS NOT NULL AND option_contract_id IS NULL) OR (instrument_id IS NULL AND option_contract_id IS NOT NULL));
        </sql>
        
        <addUniqueConstraint tableName="positions" columnNames="user_id, instrument_id" constraintName="uq_pos_user_inst"/>
        <addUniqueConstraint tableName="positions" columnNames="user_id, option_contract_id" constraintName="uq_pos_user_opt"/>

        <createTable tableName="position_snapshots">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="market_tick_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_posnap_tick" references="market_ticks(id)"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_posnap_user" references="users(id)"/>
            </column>
            <column name="position_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_posnap_pos" references="positions(id)"/>
            </column>
            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="market_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="market_value" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="unrealized_pnl" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="delta" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="gamma" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="theta" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="vega" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="rho" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex tableName="position_snapshots" indexName="idx_posnap_user_time">
            <column name="user_id"/>
            <column name="timestamp" descending="true"/>
        </createIndex>

        <createTable tableName="portfolio_snapshots">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="market_tick_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_portsnap_tick" references="market_ticks(id)"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_portsnap_user" references="users(id)"/>
            </column>
            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="cash_balance" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_cash" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="available_cash" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="portfolio_value" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="total_equity" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="realized_pnl" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="unrealized_pnl" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="delta" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="gamma" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="theta" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="vega" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="rho" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex tableName="portfolio_snapshots" indexName="idx_portsnap_user_time">
            <column name="user_id"/>
            <column name="timestamp" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
