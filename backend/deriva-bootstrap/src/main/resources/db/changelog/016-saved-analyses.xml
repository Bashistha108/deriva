<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="1" author="deriva">
        <createTable tableName="saved_analyses">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_sanalysis_user" references="users(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="strategy_id" type="UUID">
                <constraints nullable="true" foreignKeyName="fk_sanalysis_strategy" references="strategies(id)"/>
            </column>
            <column name="underlying_instrument_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_sanalysis_inst" references="instruments(id)"/>
            </column>
            <column name="underlying_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="volatility" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="risk_free_rate" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="days_to_expiration" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="saved_analysis_legs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="saved_analysis_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_saleg_analysis" references="saved_analyses(id)"/>
            </column>
            <column name="option_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="side" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="strike" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="premium" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
