<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="017-settings-table" author="antigravity">
        <createTable tableName="settings">
            <column name="setting_key" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="setting_value" type="VARCHAR(255)"/>
        </createTable>

        <insert tableName="settings">
            <column name="setting_key" value="SIMULATION_PRICE_UPDATE_MIN_MS"/>
            <column name="setting_value" value="1000"/>
        </insert>
        <insert tableName="settings">
            <column name="setting_key" value="SIMULATION_PRICE_UPDATE_RANGE_MS"/>
            <column name="setting_value" value="9000"/>
        </insert>
        <insert tableName="settings">
            <column name="setting_key" value="SIMULATION_DATABASE_FLUSH_MS"/>
            <column name="setting_value" value="60000"/>
        </insert>
    </changeSet>

</databaseChangeLog>
