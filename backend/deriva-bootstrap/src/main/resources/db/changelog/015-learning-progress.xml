<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="1" author="deriva">
        <createTable tableName="user_lesson_progress">
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_ulp_user" references="users(id)"/>
            </column>
            <column name="lesson_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_ulp_lesson" references="lessons(id)"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="last_viewed_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_lesson_progress" columnNames="user_id, lesson_id" constraintName="pk_user_lesson_progress"/>

    </changeSet>

</databaseChangeLog>
