<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="1" author="deriva">
        <createTable tableName="market_price_snapshots">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="market_tick_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_snap_tick" references="market_ticks(id)"/>
            </column>
            <column name="simulation_run_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_snap_sim" references="simulation_runs(id)"/>
            </column>
            <column name="instrument_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_snap_instrument" references="instruments(id)"/>
            </column>
            <column name="market_session_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_snap_session" references="market_sessions(id)"/>
            </column>
            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="previous_price" type="NUMERIC(19, 4)"/>
            <column name="change" type="NUMERIC(19, 4)"/>
            <column name="change_percent" type="NUMERIC(19, 4)"/>
            <column name="volume" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="instrument_market_states">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="instrument_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_state_instrument" references="instruments(id)"/>
            </column>
            <column name="market_tick_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_state_tick" references="market_ticks(id)"/>
            </column>
            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="volatility" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="drift" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="volume" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="market_regime" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
