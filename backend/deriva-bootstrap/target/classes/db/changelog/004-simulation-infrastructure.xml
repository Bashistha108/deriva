<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="1" author="deriva">
        <createTable tableName="simulation_runs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="seed" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="ended_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="simulation_state">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="simulation_run_id" type="UUID">
                <constraints nullable="false" unique="true" foreignKeyName="fk_state_sim_run" references="simulation_runs(id)"/>
            </column>
            <column name="current_simulated_timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="current_market_session_id" type="BIGINT"/>
            <column name="last_completed_tick_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="market_configurations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="risk_free_rate" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="calculation_interval_seconds" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="live_update_interval_seconds" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="persistence_interval_seconds" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="market_open_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="market_close_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="settlement_start_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="settlement_end_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="timezone" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="market_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="market_configuration_versions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="effective_from" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="effective_until" type="TIMESTAMP"/>
            <column name="risk_free_rate" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="calculation_interval_seconds" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="live_update_interval_seconds" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="persistence_interval_seconds" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="market_open_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="market_close_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="settlement_start_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="settlement_end_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="timezone" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="market_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="market_sessions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="simulation_run_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_session_sim_run" references="simulation_runs(id)"/>
            </column>
            <column name="trading_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="opens_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="closes_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="closed_at" type="TIMESTAMP"/>
        </createTable>

        <createTable tableName="market_ticks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="simulation_run_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_tick_sim_run" references="simulation_runs(id)"/>
            </column>
            <column name="simulated_timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="sequence_number" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="calculation_started_at" type="TIMESTAMP"/>
            <column name="calculation_completed_at" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Initial seed for MarketConfiguration -->
        <!-- Note: updated_by is arbitrary UUID for initial setup -->
        <insert tableName="market_configurations">
            <column name="risk_free_rate" valueNumeric="0.05"/>
            <column name="calculation_interval_seconds" valueNumeric="1"/>
            <column name="live_update_interval_seconds" valueNumeric="1"/>
            <column name="persistence_interval_seconds" valueNumeric="10"/>
            <column name="market_open_time" value="02:00:00"/>
            <column name="market_close_time" value="02:00:00"/>
            <column name="settlement_start_time" value="06:00:00"/>
            <column name="settlement_end_time" value="06:00:00"/>
            <column name="timezone" value="Europe/Berlin"/>
            <column name="market_status" value="CLOSED"/>
            <column name="updated_at" valueDate="2024-01-01T00:00:00"/>
            <column name="updated_by" value="00000000-0000-0000-0000-000000000000"/>
        </insert>
    </changeSet>

</databaseChangeLog>
