<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="1" author="deriva">
        <createTable tableName="option_market_snapshots">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="market_tick_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_opt_snap_tick" references="market_ticks(id)"/>
            </column>
            <column name="option_contract_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_opt_snap_contract" references="option_contracts(id)"/>
            </column>
            <column name="market_session_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_opt_snap_session" references="market_sessions(id)"/>
            </column>
            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="underlying_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="theoretical_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="bid_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="ask_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="mid_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="implied_volatility" type="NUMERIC(19, 6)"/>
            <column name="delta" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="gamma" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="theta" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="vega" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="rho" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="volume" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="open_interest" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Index to quickly find history for an option contract -->
        <createIndex tableName="option_market_snapshots" indexName="idx_opt_snapshots_contract_time">
            <column name="option_contract_id"/>
            <column name="timestamp" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
